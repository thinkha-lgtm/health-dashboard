<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Personal Health Dashboard</title>
    <!-- Google Fonts & Chart.js CDN -->
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Kanit', sans-serif;
        }
        body {
            background-color: #f4f7fe;
            color: #2b3674;
            padding: 20px;
        }
        .container {
            max-width: 1100px;
            margin: 0 auto;
        }
        header {
            margin-bottom: 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }
        header h1 {
            font-size: 24px;
            font-weight: 600;
            color: #1b2559;
        }
        header .user-info {
            background: #ffffff;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 14px;
            color: #707e94;
            box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.03);
        }

        /* KPI Cards Grid */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 15px;
            margin-bottom: 25px;
        }
        .kpi-card {
            background: #ffffff;
            padding: 20px;
            border-radius: 16px;
            box-shadow: 0px 4px 16px rgba(112, 144, 176, 0.08);
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .kpi-icon {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }
        .kpi-details h3 {
            font-size: 13px;
            color: #a3edba;
            color: #8f9bba;
            font-weight: 400;
        }
        .kpi-details p {
            font-size: 22px;
            font-weight: 600;
            color: #1b2559;
        }

        /* Main Content Layout */
        .dashboard-content {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 20px;
        }
        @media (max-width: 850px) {
            .dashboard-content {
                grid-template-columns: 1fr;
            }
        }

        .card {
            background: #ffffff;
            padding: 22px;
            border-radius: 16px;
            box-shadow: 0px 4px 16px rgba(112, 144, 176, 0.08);
            margin-bottom: 20px;
        }
        .card-title {
            font-size: 16px;
            font-weight: 600;
            color: #1b2559;
            margin-bottom: 15px;
        }

        /* Table Style */
        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 14px;
        }
        th, td {
            padding: 12px 10px;
            border-bottom: 1px solid #f1f5f9;
        }
        th {
            color: #8f9bba;
            font-weight: 500;
        }
        td {
            color: #2b3674;
        }
        .badge {
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 500;
        }
        .badge-workout { background-color: #e6f7ff; color: #0070f3; }
        .badge-rest { background-color: #f5f5f5; color: #8c8c8c; }
    </style>
</head>
<body>

<div class="container">
    <header>
        <div>
            <h1>Dashboard สุขภาพประจำสัปดาห์</h1>
            <p style="color: #8f9bba; font-size: 14px;">รายงานข้อมูล 7 - 13 กันยายน</p>
        </div>
        <div class="user-info">
            👤 น้ำหนักตัว: <b>85 กก.</b> | เป้าหมายออกกำลังกาย: <b>5 วัน/สัปดาห์</b>
        </div>
    </header>

    <!-- KPI Summary Grid -->
    <section class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon" style="background: #e6f7ff; color: #0070f3;">🏃</div>
            <div class="kpi-details">
                <h3>จำนวนวันออกกำลังกาย</h3>
                <p>5 / 7 <span style="font-size: 13px; color: #52c41a; font-weight: 400;">(บรรลุเป้าหมาย)</span></p>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon" style="background: #fff7e6; color: #fa8c16;">⏱️</div>
            <div class="kpi-details">
                <h3>เวลารวมออกกำลังกาย</h3>
                <p>195 นาที</p>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon" style="background: #f0f5ff; color: #2f54eb;">🌙</div>
            <div class="kpi-details">
                <h3>ชั่วโมงนอนเฉลี่ย</h3>
                <p>7.1 ชม. / คืน</p>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon" style="background: #e6fffb; color: #13c2c2;">💧</div>
            <div class="kpi-details">
                <h3>ปริมาณน้ำเฉลี่ย</h3>
                <p>2.0 ลิตร / วัน</p>
            </div>
        </div>
    </section>

    <!-- Content Area: Chart & Table -->
    <div class="dashboard-content">
        <!-- Chart Section -->
        <div class="card">
            <div class="card-title">📈 แนวโน้มการนอนหลับและการดื่มน้ำ (7 วัน)</div>
            <canvas id="healthChart" height="200"></canvas>
        </div>

        <!-- Activity Table Section -->
        <div class="card">
            <div class="card-title">📋 บันทึกกิจกรรมรายวัน</div>
            <table>
                <thead>
                    <tr>
                        <th>วันที่</th>
                        <th>กิจกรรม</th>
                        <th>ระยะเวลา</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>7 ก.ย. (จ)</td>
                        <td><span class="badge badge-workout">วิ่ง</span></td>
                        <td>30 นาที</td>
                    </tr>
                    <tr>
                        <td>8 ก.ย. (อ)</td>
                        <td><span class="badge badge-workout">ปั่นจักรยาน</span></td>
                        <td>45 นาที</td>
                    </tr>
                    <tr>
                        <td>9 ก.ย. (พ)</td>
                        <td><span class="badge badge-workout">เวทเทรนนิ่ง</span></td>
                        <td>40 นาที</td>
                    </tr>
                    <tr>
                        <td>10 ก.ย. (พฤ)</td>
                        <td><span class="badge badge-workout">ว่ายน้ำ</span></td>
                        <td>50 นาที</td>
                    </tr>
                    <tr>
                        <td>11 ก.ย. (ศ)</td>
                        <td><span class="badge badge-rest">พักผ่อน (Rest)</span></td>
                        <td>-</td>
                    </tr>
                    <tr>
                        <td>12 ก.ย. (ส)</td>
                        <td><span class="badge badge-workout">เดินเร็ว</span></td>
                        <td>30 นาที</td>
                    </tr>
                    <tr>
                        <td>13 ก.ย. (อา)</td>
                        <td><span class="badge badge-rest">พักผ่อน (Rest)</span></td>
                        <td>-</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Chart Configuration Script -->
<script>
    const ctx = document.getElementById('healthChart').getContext('2d');
    const healthChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: ['7 ก.ย.', '8 ก.ย.', '9 ก.ย.', '10 ก.ย.', '11 ก.ย.', '12 ก.ย.', '13 ก.ย.'],
            datasets: [
                {
                    label: 'การนอน (ชม.)',
                    data: [7.2, 6.5, 7.0, 7.5, 8.0, 6.8, 7.0],
                    borderColor: '#2f54eb',
                    backgroundColor: 'rgba(47, 84, 235, 0.1)',
                    tension: 0.3,
                    yAxisID: 'y'
                },
                {
                    label: 'น้ำดื่ม (ลิตร)',
                    data: [1.8, 1.5, 2.2, 2.0, 2.5, 1.8, 2.2],
                    borderColor: '#13c2c2',
                    backgroundColor: 'rgba(19, 194, 194, 0.1)',
                    tension: 0.3,
                    yAxisID: 'y1'
                }
            ]
        },
        options: {
            responsive: true,
            interaction: {
                mode: 'index',
                intersect: false,
            },
            scales: {
                y: {
                    type: 'linear',
                    display: true,
                    position: 'left',
                    title: { display: true, text: 'ชั่วโมงการนอน' },
                    suggestedMin: 5,
                    suggestedMax: 10
                },
                y1: {
                    type: 'linear',
                    display: true,
                    position: 'right',
                    title: { display: true, text: 'ปริมาณน้ำ (ลิตร)' },
                    grid: { drawOnChartArea: false },
                    suggestedMin: 1,
                    suggestedMax: 4
                }
            }
        }
    });
</script>

</body>
</html>
